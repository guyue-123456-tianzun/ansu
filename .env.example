# 数据库
DB_URL=jdbc:mysql://127.0.0.1:3306/ansu?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_USER=ansu
DB_PASSWORD=ansu

# Java JWT（至少 32 字节）
JWT_SECRET=ansu-dev-secret-change-me-at-least-32-bytes

# Java -> Python
AI_BASE_URL=http://127.0.0.1:8000
INTERNAL_TOKEN=dev-internal-token

# 演示
DEMO_MODE=true

# RAG（RG01 = GLM-4-Plus；如切本地 Qwen 改 RAG_LLM_MODE=local）
RAG_ENABLED=true
RAG_LLM_MODE=api
RAG_LLM_MODEL=glm-4-plus
RAG_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RAG_LLM_API_KEY=
RAG_LLM_MAX_SNIPPETS=6
RAG_LLM_REDACT=true
RAG_CHROMA_DIR=data/chroma
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.35
